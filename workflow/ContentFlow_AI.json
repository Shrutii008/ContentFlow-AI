    {
      "parameters": {
        "jsCode": "const output = $json.content?.parts?.[0]?.text;\n\nif (!output) {\n  throw new Error('Gemini did not return content.parts[0].text');\n}\n\nlet contentWriter;\n\ntry {\n  contentWriter = JSON.parse(output);\n} catch (error) {\n  throw new Error('Content Writer returned invalid JSON');\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      contentWriter\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1232,
        -80
      ],
      "id": "fab8e89e-4596-4d77-91f6-9dbc573c7326",
      "name": "Parse Generated Content  "
