      ],
      "id": "abcbf693-5953-4860-a838-73b815fb7c8b",
      "name": "AI Content Reviewer",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "2KX7zT1mW148lAsl",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
