    {
      "parameters": {
        "jsCode": "const output = $json.content?.parts?.[0]?.text;\n\nif (!output) {\n  throw new Error('Reviewer did not return content.parts[0].text');\n}\n\nlet review;\n\ntry {\n  review = JSON.parse(output);\n} catch (error) {\n  throw new Error('Content Reviewer returned invalid JSON');\n}\n\n// Get original generated post from the first Message a model node\nconst generatorOutput = $('AI Content Generator').first().json.content?.parts?.[0]?.text;\n\nif (!generatorOutput) {\n  throw new Error('Message a model output not found');\n}\n\nlet contentWriter;\n\ntry {\n  contentWriter = JSON.parse(generatorOutput);\n} catch (error) {\n  throw new Error('Message a model returned invalid JSON');\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      contentWriter,\n      review\n    }\n  }\n];"
      },
