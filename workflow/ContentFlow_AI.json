        "messages": {
          "values": [
            {
              "content": "=Topic: {{ $('Input Validation').item.json.topic }}\nAudience: {{ $('Input Validation').item.json.audience }}\nGoal: {{ $('Input Validation').item.json.goal }}\nPlatform: {{ $('Input Validation').item.json.platform }}\nTone: {{ $('Input Validation').item.json.tone }}\n\nPrevious Review Feedback:\n{{ $json.review?.feedback || \"No previous review. Generate the content normally.\" }}\n\nPrevious Review Issues:\n{{ $json.review?.issues ? JSON.stringify($json.review.issues) : \"None\" }}\n\nPrevious Review Improvements:\n{{ $json.review?.improvements ? JSON.stringify($json.review.improvements) : \"None\" }}\n\nINSTRUCTION:\nIf previous review feedback exists, create a NEW improved version of the content. Fix every issue and apply the suggested improvements. Do not simply repeat the previous version.\n\nIf no previous review feedback exists, generate the content normally.\n\nReturn ONLY the requested JSON format. Do not add markdown or explanations."
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
      },
