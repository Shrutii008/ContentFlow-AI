      "parameters": {
        "jsCode": "const requiredFields = ['id', 'topic', 'audience', 'goal', 'platform', 'tone'];\n\nfor (const item of $input.all()) {\n  const missingFields = requiredFields.filter(\n    field => !item.json[field] || String(item.json[field]).trim() === ''\n  );\n\n  if (missingFields.length > 0) {\n    item.json.validationStatus = 'INVALID';\n    item.json.validationError = `Missing required fields: ${missingFields.join(', ')}`;\n  } else {\n    item.json.validationStatus = 'VALID';\n    item.json.validationError = '';\n  }\n}\n\nreturn $input.all();"
      },
